# VCS / IDE
.git
.gitignore
.vscode
.DS_Store

# Local virtualenvs and macOS cruft
.venv
**/__pycache__/
**/*.pyc

# iCloud-sync duplicates ("name 2.ext")
**/* 2.py
**/* 2.ipynb
**/* 2.cmake
**/* 2.make
**/* 2.o
**/* 2.txt
**/* 2.d
**/* 2.yaml
**/* 2.internal
**/* 2/

# Local build trees (rebuilt inside the image)
build/
build_sim/
muon-sim/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile

# Local Geant4 SDK (rebuilt from source in stage 1)
Geant4-11.3.0-Darwin/

# Generated outputs (regenerated by the pipeline)
output/
results/
muon-sim/output/
analysis/figures*/
analysis/__pycache__ 2/

# Notebooks are dev-time only in the container
analysis/*.ipynb
.ipynb_checkpoints/
